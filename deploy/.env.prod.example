# 서버의 /opt/sinchonton/.env.prod 로 이 파일을 참고해 채워넣으세요. (커밋 금지)
MYSQL_ROOT_PASSWORD=change-me
MYSQL_PASSWORD=change-me

# JWT 서명 키. 32바이트 이상의 임의 문자열로 채우세요.
JWT_SECRET=change-me

# 관리자 API(/api/admin/**) 호출 시 X-Admin-Key 헤더에 넣을 값. 임의의 문자열로 채우세요.
ADMIN_KEY=change-me

# 카카오 개발자센터 > 앱 설정 > 요약 정보 (REST API 키) / 카카오 로그인 > 보안 (Client Secret)
KAKAO_CLIENT_ID=change-me
KAKAO_CLIENT_SECRET=change-me

# 카카오 로그인 완료 후 돌려보낼 프론트 주소
OAUTH2_REDIRECT_URI=change-me
OAUTH2_ALLOWED_REDIRECT_ORIGINS=change-me
CORS_ALLOWED_ORIGINS=change-me
